{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoeKoe Music",
  "version": "1.7.0",
  "identifier": "cn.MoeKoe.Music",
  "build": {
    "beforeDevCommand": "node scripts/sync-version.mjs && npm run serve",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "node scripts/sync-version.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src * data: blob: https: http:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https:; connect-src * https: http: ws: wss:; media-src * data: blob: https: http:; font-src * data: https: http:; frame-src * https: http:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "moekoe"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icons/icon.ico",
      "../build/icons/icon.icns",
      "../build/icons/linux-icon.png"
    ],
    "resources": {
      "../public/assets/sound/": "assets/sound/"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "both"
      }
    }
  }
}
