{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoeKoe Music",
  "version": "1.6.9",
  "identifier": "cn.MoeKoe.Music",
  "build": {
    "beforeDevCommand": "node scripts/sync-version.mjs && npm run serve",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "node scripts/sync-version.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "moekoe"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icons/icon.ico",
      "../build/icons/icon.icns",
      "../build/icons/linux-icon.png"
    ],
    "resources": {
      "../public/assets/sound/": "assets/sound/"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "both"
      }
    }
  }
}
